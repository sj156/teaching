%   \sj{Check this argument.}
\DeclareRobustCommand{\sj}[1]{\textcolor{red}{\textbf{[#1]}}}


% --------------------------------------------------------------------
% Distributional-sim notation
% --------------------------------------------------------------------
%
% Usage:
%   X \distas{d} Y
%   X \distas{\mathrm{approx}} Y
%
%   X \distras{\mathrm{ind}} F
%
% \distas places a label above an ordinary \sim.
% \distras stretches the \sim to approximately match the width of the
% label. The stretched version uses \resizebox from graphicx.

\makeatletter

\DeclareRobustCommand{\distas}[1]{%
  \mathrel{\overset{#1}{\kern\z@\sim}}%
}

\newsavebox{\mymathnotes@distlabelbox}
\newsavebox{\mymathnotes@simbox}

\DeclareRobustCommand{\distras}[1]{%
  \savebox{\mymathnotes@distlabelbox}{%
    \hbox{\kern3pt$\scriptstyle #1$\kern3pt}%
  }%
  \savebox{\mymathnotes@simbox}{\hbox{$\sim$}}%
  \mathrel{%
    \overset{#1}{%
      \kern\z@
      \resizebox{\wd\mymathnotes@distlabelbox}{\ht\mymathnotes@simbox}{$\sim$}%
    }%
  }%
}


% --------------------------------------------------------------------
% Equality and approximation relation symbols
% --------------------------------------------------------------------
%
% Original command names are preserved:
%   \eqdef    equality by definition
%   \eqind    equality in distribution
%   \eqas     almost-sure equality
%   \approxid approximate equality in distribution
%
% These are math relations, so they receive proper relation spacing.

\newcommand{\eqdef}{\mathrel{\overset{\Delta}{=\joinrel=}}}
\newcommand{\eqind}{\mathrel{\overset{\mathcal{D}}{=\joinrel=}}}
\newcommand{\eqas}{\mathrel{\overset{\mathrm{a.s.}}{=\joinrel=}}}
\newcommand{\approxid}{\mathrel{\overset{\mathcal{D}}{\approx}}}

\makeatother



