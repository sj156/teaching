% --------------------------------------------------------------------
% Theorem styles for examples, exercises, remarks, and counterexamples
% --------------------------------------------------------------------
%
% These environments preserve the original style:
%   - colored theorem head,
%   - normal body text,
%   - custom ending symbol.
%
% They are intentionally not shaded, matching the original example,
% exercise, and remark environments.

% --- Examples ---
\newtheoremstyle{example_style}
  {10pt}{10pt}    % Space above/below
  {\normalfont}   % Body font
  {}              % Indent amount
  {\bfseries}     % Theorem head font
  {}              % Punctuation after theorem head
  {1em}           % Space after theorem head
  {\colorbox{blue!25}{\thmname{#1}\thmnumber{ #2}}\thmnote{ (#3)}}

% --- Counterexamples ---
\newtheoremstyle{counterexample_style}
  {10pt}{10pt}    % Space above/below
  {\normalfont}   % Body font
  {}              % Indent amount
  {\bfseries}     % Theorem head font
  {}              % Punctuation after theorem head
  {1em}           % Space after theorem head
  {\colorbox{brick!25}{\thmname{#1}\thmnumber{ #2}}\thmnote{ (#3)}}

% --- Exercises ---
\newtheoremstyle{exercise_style}
  {10pt}{10pt}    % Space above/below
  {\normalfont}   % Body font
  {}              % Indent amount
  {\bfseries}     % Theorem head font
  {}              % Punctuation after theorem head
  {1em}           % Space after theorem head
  {\colorbox{cyan!25}{\thmname{#1}\thmnumber{ #2}}\thmnote{ (#3)}}

% --- Remarks ---
\newtheoremstyle{remark_style}
  {10pt}{10pt}    % Space above/below
  {\normalfont}   % Body font
  {}              % Indent amount
  {\bfseries}     % Theorem head font
  {}              % Punctuation after theorem head
  {1em}           % Space after theorem head
  {\colorbox{red!25}{\thmname{#1}\thmnumber{ #2}}\thmnote{ (#3)}}


