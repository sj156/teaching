% --------------------------------------------------------------------
% Inline R/code helpers
% --------------------------------------------------------------------
%
% These commands produce small inline boxes for code-related terms.
%
% Usage examples:
%   \Rcode{lm(y ~ x)}
%   \Rdata{mtcars}
%   \Rpackage{ggplot2}
%
% The visual style preserves the original package behavior:
%   - \Rcode     yellow background
%   - \Rdata     green background
%   - \Rpackage  light gray background
%
% The contents are treated as literal code using \detokenize, so common
% code characters such as underscores can be written directly:
%   \Rcode{my_variable}

\tcbset{
  mymathnotes/inlinecode/.style={
    enhanced,
    on line,
    boxrule=0pt,
    arc=2pt,
    boxsep=2pt,
    left=1pt,
    right=1pt,
    top=0pt,
    bottom=0pt,
    tcbox raise base,
    nobeforeafter
  }
}

\makeatletter

\newcommand{\mymathnotes@inlinecodebox}[2]{%
  \tcbox[mymathnotes/inlinecode,colback=#1]{%
    \ttfamily\detokenize{#2}%
  }%
}

\DeclareRobustCommand{\Rcode}[1]{%
  \mymathnotes@inlinecodebox{yellow!40}{#1}%
}

\DeclareRobustCommand{\Rdata}[1]{%
  \mymathnotes@inlinecodebox{green!20}{#1}%
}

\DeclareRobustCommand{\Rpackage}[1]{%
  \mymathnotes@inlinecodebox{black!10}{#1}%
}

\makeatother


% --------------------------------------------------------------------
% Listings styles
% --------------------------------------------------------------------
%
% The original package configured listings globally for R.
% We now define a named style, mymathnotesR, and then apply it globally
% to preserve the original behavior.
%
% Usage:
%   \begin{lstlisting}
%   x <- rnorm(100)
%   mean(x)
%   \end{lstlisting}
%
% Or explicitly:
%   \begin{lstlisting}[style=mymathnotesR]
%   x <- rnorm(100)
%   mean(x)
%   \end{lstlisting}

\lstdefinestyle{mymathnotesR}{
  language=R,
  backgroundcolor=\color{backcolour},
  commentstyle=\color{codegreen},
  keywordstyle=\color{magenta},
  numberstyle=\tiny\color{codegray},
  stringstyle=\color{codepurple},
  basicstyle=\ttfamily\footnotesize,
  breakatwhitespace=false,
  breaklines=true,
  captionpos=b,
  keepspaces=true,
  numbers=left,
  numbersep=5pt,
  showspaces=false,
  showstringspaces=false,
  showtabs=false,
  tabsize=2
}

% Variant without line numbers.
\lstdefinestyle{mymathnotesRNoNumbers}{
  style=mymathnotesR,
  numbers=none
}

% Preserve original package behavior: ordinary lstlisting environments
% use the R style by default.
\lstset{style=mymathnotesR}


% Convenience environment for R listings.
%
% Usage:
%   \begin{Rlisting}
%   x <- rnorm(100)
%   mean(x)
%   \end{Rlisting}
%
% Optional listings settings may still be passed:
%   \begin{Rlisting}[caption={Simulation code}, numbers=none]
%   ...
%   \end{Rlisting}

\lstnewenvironment{Rlisting}[1][]
  {\lstset{style=mymathnotesR,#1}}
  {}



