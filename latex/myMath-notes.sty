% --------------------------------------------------------------------
% Standard lecture-note layout
% --------------------------------------------------------------------
%
% These settings standardize the appearance of lecture notes using this
% package. They are applied automatically.

\geometry{
  letterpaper,
  left=0.9in,
  right=0.9in,
  top=0.7in,
  bottom=0.75in,
  includefoot,
  %verbose,  
  ignoremp
}

% Standard figure directory for lecture notes.
% Paths are relative to the main .tex file.
\graphicspath{{./figures/}}

% Table of contents depth.
\setcounter{tocdepth}{2} 


% --------------------------------------------------------------------
% Layered navigation for lecture notes
% --------------------------------------------------------------------
%
% Page breaks remain the responsibility of the master document, so the
% document structure stays visible there.
%
%   \notesoverviewcontents              % sections
%   \notesdetailedcontents              % subsections
%   \part{...}\localpartcontents        % subsubsections in that part

\NewDocumentCommand{\notesoverviewcontents}{O{Contents at a Glance}}{%
  \begingroup
  \renewcommand{\contentsname}{#1}%
  \etocsetnexttocdepth{section}%
  \tableofcontents
  \endgroup
}

\NewDocumentCommand{\notesdetailedcontents}{O{Detailed Contents}}{%
  \begingroup
  \renewcommand{\contentsname}{#1}%
  \etocsetnexttocdepth{subsection}%
  \tableofcontents
  \endgroup
}

% Unnumbered front-matter sections need both a hyperlink target and a table
% of contents entry.  Keeping that bookkeeping here prevents individual
% front-matter files from drifting apart.
\NewDocumentCommand{\notesfrontsection}{m}{%
  \section*{#1}%
  \phantomsection
  \addcontentsline{toc}{section}{#1}%
}

\newcommand*{\localpartcontents}{%
  \begingroup
  \small
  \etocsetnexttocdepth{subsubsection}%
  \etocsettocstyle
    {\section*{Local Contents for Part~\thepart}}
    {}%
  \localtableofcontents
  \endgroup
}

% Float numbering follows the selected policy; equations remain section-based.
\ifnotesSubsectionFloats
  \counterwithin{figure}{subsection}
  \counterwithin{table}{subsection}
\else
  \counterwithin{figure}{section}
  \counterwithin{table}{section}
\fi
\numberwithin{equation}{section}

% Algorithms are numbered within subsections (e.g. Algorithm 3.3.1).
\counterwithin{algorithm}{subsection}

% Slightly roomier tables.
\renewcommand{\arraystretch}{1.25}



% Hyperref is intentionally managed by myMath-notes.
% It is loaded without package options and configured via \hypersetup
% to reduce option-clash problems.
\RequirePackage{hyperref}

\hypersetup{
  colorlinks=true,
  linkcolor=blue!60!black,
  citecolor=blue!75!black,
  urlcolor=blue!60!black
}

% tablefootnote works best after hyperref when linked footnotes are desired.
\RequirePackage{tablefootnote}

% Figure and table counters reset within sections above.  Their PDF anchors
% must retain the section number as well, or hyperref can create duplicate
% destinations when the visible counter restarts.
\ifnotesSubsectionFloats
  \renewcommand*{\theHfigure}{\theHsubsection.\arabic{figure}}
  \renewcommand*{\theHtable}{\theHsubsection.\arabic{table}}
\else
  \renewcommand*{\theHfigure}{\theHsection.\arabic{figure}}
  \renewcommand*{\theHtable}{\theHsection.\arabic{table}}
\fi

% Keep algorithm hyperlink destinations unique after subsection resets.
\providecommand*{\theHalgorithm}{}
\renewcommand*{\theHalgorithm}{\theHsubsection.\arabic{algorithm}}

