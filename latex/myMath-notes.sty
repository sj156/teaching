% --------------------------------------------------------------------
% Calculus and derivative notation
% --------------------------------------------------------------------
%
% Preferred descriptive commands:
%   \jacobian{f}{x}    -> partial(f)/partial(x)
%   \pderiv{f}{x}      -> partial f / partial x
%   \ppderiv{f}{x}{y}  -> partial^2 f / partial x partial y
%   \deriv{f}{x}       -> d f / d x
%   \ddt{f}            -> d f / d t
%   \fderiv{F}{f}      -> delta F / delta f
%
% Original shorter names are preserved as compatibility aliases:
%   \Jacob, \prtl, \di, \dii, \Total, \Func.

% Upright differential symbol.
% Usage:
%   \int f(x)\,\dd x
%   \deriv{f}{x}
\newcommand{\dd}{\mathop{}\!\mathrm{d}}

% Descriptive derivative commands.
\newcommand{\jacobian}[2]{\frac{\partial(#1)}{\partial(#2)}}
\newcommand{\pderiv}[2]{\frac{\partial #1}{\partial #2}}
\newcommand{\ppderiv}[3]{\frac{\partial^{2} #1}{\partial #2\,\partial #3}}
\newcommand{\deriv}[2]{\frac{\dd #1}{\dd #2}}
\newcommand{\fderiv}[2]{\frac{\delta #1}{\delta #2}}

% Original compatibility aliases.
\newcommand{\Jacob}[2]{\jacobian{#1}{#2}}
\newcommand{\prtl}[2]{\pderiv{#1}{#2}}
\newcommand{\di}[2]{\pderiv{#1}{#2}}
\newcommand{\dii}[3]{\ppderiv{#1}{#2}{#3}}
\newcommand{\Total}[2]{\deriv{#1}{#2}}
\newcommand{\ddt}[1]{\deriv{#1}{t}}
\newcommand{\Func}[2]{\fderiv{#1}{#2}}


