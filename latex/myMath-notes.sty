\newcommand{\readingbox@begin}[5]{%
  \begin{tcolorbox}[%
    sta5001/readingbox,
    colback=#2,
    colframe=#3,
    borderline west={2.5pt}{0pt}{#3},
    title={\strut #1~\thesubsection},
    boxed title style={
      colback=#3,
      colframe=#3
    }
  ]%
  \def\readingbox@endlist{#5}%
  \readingbox@itemsopenfalse
  \let\readingbox@olditem\item
  \renewcommand{\item}{%
    \ifreadingbox@itemsopen
      \readingbox@olditem
    \else
      \readingbox@itemsopentrue
      \par#4%
      \readingbox@olditem
    \fi
  }%
  \ignorespaces
}

\newcommand{\readingbox@end}{%
  \ifreadingbox@itemsopen
    \readingbox@endlist
  \else
    \par
  \fi
  \let\item\readingbox@olditem
  \end{tcolorbox}%
  \ignorespacesafterend
}

