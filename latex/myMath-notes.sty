%   divergence, written as \nabla\cdot.
%
% Use \divsign for the ordinary division symbol.

\providecommand{\grad}{\nabla}
\newcommand{\Div}{\grad\!\cdot}

\renewcommand{\div}{\Div}


% --------------------------------------------------------------------
% Probability/statistics abbreviations and symbols
% --------------------------------------------------------------------
%
% The following text-style shortcuts are designed to work in ordinary
% text and, when needed, inside math mode.
%
% Examples:
%   The variables are \iid with common density \(f\).
%   \(X_1,\dots,X_n\) are \iid.
%   The matrix is \pd.
%
% The xspace package preserves the convenient original behavior of
% writing "\iid sample" without needing "\iid{} sample", while avoiding
% most unwanted spaces before punctuation.

\makeatletter

\newcommand{\mymathnotes@abbr}[1]{%
  \ifmmode
    \text{#1}%
  \else
    #1\@%
  \fi
  \xspace
}

\newcommand{\mymathnotes@phrase}[1]{%
  \ifmmode
    \text{#1}%
  \else
    #1%
  \fi
  \xspace
}

