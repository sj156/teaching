% --------------------------------------------------------------------
% Package policy
% --------------------------------------------------------------------
%
% myMath-notes is a personal lecture-notes package.
%
% Design choices:
%   1. This package intentionally loads and configures hyperref.
%   2. This package intentionally loads and configures natbib.
%   3. This package intentionally sets the standard lecture-notes page
%      geometry, numbering style, table spacing, and graphics path.
%   4. Theorem-like environments use amsthm + framed/shaded, not
%      tcolorbox, in order to preserve the original visual style.
%   5. tcolorbox is still used for inline code boxes and selected
%      pedagogical display boxes.
%
% User-facing convention:
%   - For lecture notes, the document preamble should usually contain
%     only:
%
%       \documentclass[11pt]{article}
%       \usepackage{myMath-notes}
%
%   - Use \usepackage[subsectionfloats]{myMath-notes} when figures and
%     tables should be numbered within subsections.
%   - algorithm and algpseudocode are loaded here; use algorithm with
%     algorithmic for numbered language-neutral procedures.
%
%   - Do not separately load hyperref, natbib, geometry, xcolor,
%     amsmath, amsthm, graphicx, tikz, pgfplots, listings, framed,
%     tablefootnote, needspace, etoc, or the other packages managed here.
%
%   - To customize link behavior, use \hypersetup{...} after loading
%   myMath-notes.


% Optional float numbering policy; default remains section-based.
\newif\ifnotesSubsectionFloats
\DeclareOption{subsectionfloats}{\notesSubsectionFloatstrue}
\ProcessOptions\relax

